/* RSVP Form */
.rsvp-form {
    max-width: 500px;
    margin: 30px auto 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
}
.rsvp-form input, .rsvp-form select, .rsvp-form textarea {
    width: 100%;
    padding: 15px;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-family: var(--font-text);
}
.rsvp-form input:focus, .rsvp-form select:focus, .rsvp-form textarea:focus {
