.event-card {
    background: var(--text-light);
    padding: 40px 20px;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    border-top: 5px solid var(--primary-color);
}
.icon-event {
    font-size: 2.5rem;
    color: var(--primary-color);
    margin-bottom: 20px;
}
.event-card h3 {
    font-size: 2rem;
    margin-bottom: 15px;
}

/* Amplop Digital */
.bank-card {
    background: #fff;
    max-width: 400px;
    margin: 30px auto 0;
    padding: 30px;
    border-radius: 15px;
    box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    border: 1px solid var(--secondary-color);
}
.btn-copy {
