/* Variabel Warna Tema (Ubah warna di sini untuk mengganti tema keseluruhan) */
:root {
    --primary-color: #8c7b67; /* Warna Coklat/Sage elegan */
    --secondary-color: #eaddcf;
    --bg-light: #faf8f5;
    --text-dark: #333333;
    --text-light: #ffffff;
    --font-title: 'Cormorant Garamond', serif;
    --font-text: 'Montserrat', sans-serif;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    font-family: var(--font-text);
    color: var(--text-dark);
    background-color: var(--bg-light);
    line-height: 1.6;
    overflow-x: hidden;
}

/* Tipografi Dasar */
h1, h2, h3, .ampersand {
    font-family: var(--font-title);
    color: var(--primary-color);
}

.section-padding {
    padding: 80px 20px;
}

.container {
    max-width: 900px;
    margin: 0 auto;
}

.text-center {
    text-align: center;
}

.section-title {
    font-size: 2.5rem;
    margin-bottom: 30px;
    font-weight: 600;
}

/* Tombol Global */
.btn-primary {
    display: inline-block;
    padding: 12px 30px;
    background-color: var(--primary-color);
    color: var(--text-light);
    text-decoration: none;
    border: none;
    border-radius: 30px;
    font-family: var(--font-text);
    font-size: 0.9rem;
    cursor: pointer;
    transition: 0.3s;
    margin-top: 15px;
}
.btn-primary:hover {
    background-color: #6a5a4a;
}

/* Hero Section */
.hero {
    height: 100vh;
    background: url('https://images.unsplash.com/photo-1519225421980-715cb0215aed?ixlib=rb-4.0.3&auto=format&fit=crop&w=1920&q=80') center/cover no-repeat;
    position: relative;
    background-attachment: fixed;
}
.hero-overlay {
    position: absolute;
    top: 0; left: 0; width: 100%; height: 100%;
    background: rgba(0, 0, 0, 0.5);
    display: flex;
    justify-content: center;
    align-items: center;
    text-align: center;
}
.hero-content {
    color: var(--text-light);
}
.hero-content .subtitle {
    letter-spacing: 3px;
    font-size: 0.9rem;
    margin-bottom: 10px;
}
.hero-content .title {
    font-size: 4.5rem;
    color: var(--text-light);
    margin-bottom: 10px;
    text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
}
.hero-content .date {
    font-size: 1.2rem;
    letter-spacing: 2px;
    margin-bottom: 30px;
}
.btn-scroll {
    display: inline-block;
    padding: 10px 25px;
    border: 1px solid var(--text-light);
    color: var(--text-light);
    text-decoration: none;
    border-radius: 30px;
    transition: 0.3s;
}
.btn-scroll:hover {
    background: var(--text-light);
    color: var(--text-dark);
}

/* Profil Mempelai */
.bismillah {
    font-size: 2rem;
    margin-bottom: 15px;
}
.intro-text {
    font-size: 0.95rem;
    margin-bottom: 40px;
}
.couple-grid {
    display: flex;
    justify-content: space-around;
    align-items: center;
    flex-wrap: wrap;
}
.photo-placeholder {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    margin: 0 auto 20px;
    background-size: cover;
    background-position: center;
    border: 5px solid var(--secondary-color);
}
.woman-photo { background-image: url('https://images.unsplash.com/photo-1546804784-811c750b6910?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80'); }
.man-photo { background-image: url('https://images.unsplash.com/photo-1550091171-c053dd573ae6?ixlib=rb-4.0.3&auto=format&fit=crop&w=500&q=80'); }
.couple-grid h3 {
    font-size: 1.8rem;
    margin-bottom: 5px;
}
.ig-link {
    display: inline-block;
    margin-top: 10px;
    color: var(--text-dark);
    text-decoration: none;
    font-size: 0.9rem;
}
.ampersand {
    font-size: 4rem;
    margin: 20px;
}

/* Countdown & Acara */
.event {
    background-color: var(--secondary-color);
}
.countdown {
    display: flex;
    justify-content: center;
    gap: 15px;
    margin-bottom: 50px;
}
.time-box {
    background: var(--text-light);
    padding: 15px;
    border-radius: 10px;
    min-width: 80px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
